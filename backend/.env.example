# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database – PostgreSQL (required for Render; also works locally via Docker)
# Local: postgresql://postgres:postgres@localhost:5432/aether
# Render: paste Internal Database URL from the Postgres service
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aether"

# Auth - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
REFRESH_SECRET=another-long-random-string-for-refresh-tokens

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AI (OpenAI compatible or xAI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Music – legal sources only
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
