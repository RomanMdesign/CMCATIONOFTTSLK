# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite for local, change to postgres for production)
DATABASE_URL="file:./dev.db"

# Auth - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
REFRESH_SECRET=another-long-random-string-for-refresh-tokens

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AI (OpenAI compatible or xAI)
# Leave empty to use local rule-based fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Or for xAI:
# XAI_API_KEY=
# OPENAI_BASE_URL=https://api.x.ai/v1

# Music - Spotify (recommended for legal streaming)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Or YouTube Data API
YOUTUBE_API_KEY=

# Optional TURN for WebRTC production
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
