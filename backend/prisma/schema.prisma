generator client {
  provider = "prisma-client-js"
}

datasource db {
  // postgresql for Render/production. For local SQLite only: provider = "sqlite", DATABASE_URL="file:./dev.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  displayName   String
  passwordHash  String
  avatarUrl     String?
  bio           String?
  status        String    @default("offline")
  statusMessage String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedCommunities Community[] @relation("CommunityOwner")
  memberships      Member[]
  messages         Message[]
  reactions        Reaction[]
  friendships      Friendship[] @relation("UserFriends")
  friendOf         Friendship[] @relation("FriendOf")
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  notifications    Notification[]
  blocks           Block[] @relation("Blocker")
  blockedBy        Block[] @relation("Blocked")
  reports          Report[] @relation("Reporter")
  voiceSessions    VoiceSession[]
  musicQueues      MusicQueue[]
  aiConversations  AiConversation[]
  pinnedMessages   PinnedMessage[]
  channelReads     ChannelRead[]
  auditLogs        AuditLog[] @relation("Actor")
}

model Community {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  isPublic    Boolean  @default(true)
  ownerId     String
  owner       User     @relation("CommunityOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels  Channel[]
  members   Member[]
  roles     Role[]
  invites   Invite[]
  bans      Ban[]
  auditLogs AuditLog[]
}

model Role {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#94a3b8")
  position    Int      @default(0)
  permissions BigInt   @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  members Member[]
}

model Member {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  roleId      String?
  role        Role?    @relation(fields: [roleId], references: [id])
  nickname    String?
  joinedAt    DateTime @default(now())
  mutedUntil  DateTime?

  @@unique([userId, communityId])
}

model Channel {
  id          String   @id @default(cuid())
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  name        String
  type        String
  topic       String?
  position    Int      @default(0)
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages       Message[]
  voiceSessions  VoiceSession[]
  musicQueues    MusicQueue[]
  pinnedMessages PinnedMessage[]
  channelReads   ChannelRead[]
  participants   ChannelParticipant[]
}

model ChannelParticipant {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  joinedAt  DateTime @default(now())

  @@unique([channelId, userId])
}

model Message {
  id          String   @id @default(cuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  type        String   @default("text")
  replyToId   String?
  replyTo     Message? @relation("Replies", fields: [replyToId], references: [id])
  replies     Message[] @relation("Replies")
  threadId    String?
  isEdited    Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  attachments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reactions      Reaction[]
  pinnedMessages PinnedMessage[]
}

model Reaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  emoji     String

  @@unique([messageId, userId, emoji])
}

model PinnedMessage {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  pinnedBy  String
  pinnedAt  DateTime @default(now())
}

model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([userId, channelId])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReceivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id])
  targetType String
  targetId   String
  reason     String
  details    String?
  status     String   @default("open")
  createdAt  DateTime @default(now())
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Ban {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  reason      String?
  bannedBy    String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@unique([communityId, userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation("Actor", fields: [actorId], references: [id])
  action      String
  targetType  String?
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())
}

model VoiceSession {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMuted    Boolean  @default(false)
  isDeafened Boolean  @default(false)
  isVideo    Boolean  @default(false)
  isScreen   Boolean  @default(false)
  joinedAt   DateTime @default(now())

  @@unique([channelId, userId])
}

model MusicQueue {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  trackId    String
  title      String
  artist     String?
  artworkUrl String?
  duration   Int?
  source     String
  sourceUrl  String?
  position   Int      @default(0)
  isPlaying  Boolean  @default(false)
  addedAt    DateTime @default(now())
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String?
  messages  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
