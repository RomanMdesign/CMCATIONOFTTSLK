{
  "name": "aether-backend",
  "version": "1.0.0",
  "description": "Aether communication platform backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
